mach create "stm32f411"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl

# 1. Открываем UART для Python-скрипта
emulation CreateServerSocketTerminal 1234 "uart_socket"
connector Connect sysbus.usart1 uart_socket

# 2. Запускаем GDB-сервер для снятия дампа памяти
machine StartGdbServer 3333

# 3. Загружаем прошивку по абсолютному пути внутри Docker
sysbus LoadELF @/app/build/UART_DRIVER.elf

# 4. Снимаем процессор с паузы
start
